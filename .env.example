APP_NAME="Descan 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# ─── DATABASE (PostgreSQL) ────────────────────────────────────
# Works for both local PC (PG 13) and GitHub Codespaces
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=descan
DB_USERNAME=posgres
DB_PASSWORD=BPS-berau-6405

# ─── STORAGE ─────────────────────────────────────────────────
FILESYSTEM_DISK=public
# All uploaded files (images, PDFs, Excel) stored in storage/app/public/
# Run: php artisan storage:link

# ─── CACHE & SESSIONS ────────────────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── QUEUE ───────────────────────────────────────────────────
QUEUE_CONNECTION=sync

# ─── LOGGING ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── MAIL (optional) ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@descan.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── VITE ────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
